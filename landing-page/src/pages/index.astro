                      <div class="w-full h-1.5 rounded-full bg-slate-800 overflow-hidden mb-2">
                        <div class="h-full rounded-full" style={`width: ${p.barWidth}; background-color: ${p.colorHex}`}></div>
                      </div>
                      <p class="text-xs text-slate-300 leading-relaxed">{p.desc}</p>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- =====================================================================
