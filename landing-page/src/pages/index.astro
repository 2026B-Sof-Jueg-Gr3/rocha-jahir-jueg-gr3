                    {item.tag}
                  </span>
                  <h3 class="text-xl font-bold text-white">{item.titulo}</h3>
                  <p class="text-slate-300 text-sm leading-relaxed">{item.explicacion}</p>
                </div>
              </article>
            ))}
          </div>

          <!-- Tarjetas de Frame Data de los 3 Ataques -->
          <div class="rounded-3xl bg-[#110b22]/90 border border-cyan-500/25 p-7 sm:p-9 shadow-2xl">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
              <div>
                <span class="text-xs font-extrabold tracking-[0.2em] text-amber-400 uppercase block mb-1">
