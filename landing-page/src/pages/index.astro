    uso: 'Ciclo de escenas, físicas Arcade, Tweens, partículas aditivas y cámaras vía CDN jsDelivr.',
  },
  {
    recurso: 'Sprites y Escenarios (Fighter, Cyber-Dojo, HUD)',
    tipo: 'Arte Vectorial 100% Procedimental',
    autor: 'Jahir Rocha (Autoría propia en código)',
    licencia: 'MIT License',
    uso: 'Generados en tiempo real con Phaser.GameObjects.Graphics y generateTexture(). Cero imágenes externas.',
