                <h3 class="text-2xl sm:text-3xl font-bold text-white">
                  Frame Data Oficial del Exoesqueleto
                </h3>
              </div>
              <a
                href={gameUrl}
                class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-cyan-500/15 hover:bg-cyan-500/25 border border-cyan-400/50 text-cyan-300 font-bold text-xs tracking-wider uppercase transition"
              >
                ⚡ Probar Combos en el Dojo →
              </a>
