            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
              {ataques.map((atk) => (
                <div
                  class={`rounded-2xl bg-[#090514]/90 border ${atk.borderClass} ${atk.glowClass} p-6 flex flex-col justify-between transition-all`}
                >
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-4">
                      <span class={`px-3 py-1 rounded-lg text-xs font-extrabold border ${atk.badgeClass}`}>
                        Tecla {atk.tecla}
                      </span>
                      <span class="font-display text-2xl tracking-wider text-amber-400">{atk.dano}</span>
                    </div>
                    <h4 class="text-lg font-bold text-white mb-2">{atk.nombre}</h4>
                    <p class="text-xs text-slate-300 leading-relaxed mb-6">{atk.rol}</p>
                  </div>

                  <div class="grid grid-cols-4 gap-2 pt-4 border-t border-slate-800/80 text-center">
                    <div class="rounded-lg bg-slate-900/90 p-2">
                      <span class="text-[10px] uppercase text-slate-400 block">Startup</span>
                      <strong class="text-xs text-cyan-300 font-mono">{atk.startup}</strong>
                    </div>
                    <div class="rounded-lg bg-slate-900/90 p-2">
                      <span class="text-[10px] uppercase text-slate-400 block">Active</span>
                      <strong class="text-xs text-emerald-300 font-mono">{atk.active}</strong>
                    </div>
                    <div class="rounded-lg bg-slate-900/90 p-2">
                      <span class="text-[10px] uppercase text-slate-400 block">Recovery</span>
                      <strong class="text-xs text-rose-300 font-mono">{atk.recovery}</strong>
                    </div>
                    <div class="rounded-lg bg-slate-900/90 p-2">
                      <span class="text-[10px] uppercase text-slate-400 block">Empuje</span>
                      <strong class="text-xs text-amber-300 font-mono">{atk.knockback}</strong>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Mapa de Controles en Teclado -->
          <div id="controles" class="rounded-3xl bg-[#110b22]/90 border border-slate-800 p-7 sm:p-9 shadow-2xl">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
              <div>
                <span class="text-xs font-extrabold tracking-[0.2em] text-cyan-400 uppercase block mb-1">
                  SINCRONIZACIÓN NEURONAL EN TECLADO
                </span>
                <h3 class="text-2xl sm:text-3xl font-bold text-white">
                  Panel de Controles Arcade
                </h3>
              </div>
              <span class="px-3.5 py-1.5 rounded-full bg-slate-900 border border-cyan-500/30 text-xs font-semibold text-cyan-300">
                Compatible con WASD + Flechas de Dirección + J / K / L
              </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {controles.map((c) => (
                <div class="flex items-center gap-4 rounded-xl bg-[#090514]/80 border border-slate-800/90 hover:border-cyan-500/40 p-4 transition">
                  <kbd
                    class="min-w-[140px] text-center px-3 py-2.5 rounded-xl bg-[#17112b] border border-cyan-400/50 shadow-[0_4px_0_#0066ff] font-mono text-xs font-extrabold text-white shrink-0"
                  >
                    {c.tecla}
                  </kbd>
                  <div class="min-w-0">
                    <div class="flex items-center gap-2">
                      <strong class="text-sm font-bold text-white truncate">{c.accion}</strong>
                      <span class="text-[10px] font-extrabold px-2 py-0.5 rounded bg-slate-800 text-cyan-300">
                        {c.cat}
                      </span>
                    </div>
                    <p class="text-xs text-slate-400 mt-0.5">{c.detalle}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- =====================================================================
           5. FASE 2: ESTRUCTURA DE CUMPLIMIENTO (ESRB, LICENCIAS Y PRIVACIDAD)
           ===================================================================== -->
      <section id="cumplimiento" class="py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
          <div class="text-center max-w-3xl mx-auto">
            <span class="text-xs font-extrabold tracking-[0.25em] text-cyan-400 uppercase block mb-2">
              FASE 2 · ESTRUCTURA DE CUMPLIMIENTO COMERCIAL
            </span>
            <h2 class="font-display text-4xl sm:text-5xl tracking-wider uppercase text-white">
              Clasificación <span class="text-cyan-400 text-glow-cyan">ESRB</span>, Licencias y Privacidad
            </h2>
            <p class="mt-3 text-slate-300 text-base sm:text-lg">
              Auditoría completa de intensidad visual, propiedad intelectual bajo licencia MIT y ejecución 100% privada en el navegador del jugador.
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <!-- Distintivo ESRB E10+ y Análisis de Intensidad Visual -->
            <article class="lg:col-span-6 rounded-3xl bg-[#110b22]/95 border border-cyan-500/30 p-7 sm:p-8 shadow-2xl space-y-6">
              <div class="flex flex-col sm:flex-row sm:items-center gap-6 pb-6 border-b border-slate-800">
                <!-- Sello Visual Estilo ESRB -->
                <div
                  class="w-28 shrink-0 bg-white text-black border-4 border-black ring-2 ring-cyan-400 rounded-md text-center font-display select-none shadow-lg"
                  aria-label="Clasificación ESRB Everyone 10+"
                >
                  <div class="bg-black text-white text-[11px] tracking-[0.2em] py-1">ESRB</div>
                  <div class="text-4xl font-black py-2 leading-none">E10+</div>
                  <div class="bg-black text-white text-[10px] tracking-wider py-1">TODOS +10</div>
                </div>

                <div class="space-y-2">
                  <span class="text-xs font-extrabold tracking-[0.2em] text-amber-400 uppercase block">
                    CLASIFICACIÓN DE AUDIENCIA
                  </span>
                  <h3 class="text-2xl font-bold text-white">Everyone 10+ (Todos mayores de 10 años)</h3>
                  <ul class="text-xs text-slate-300 space-y-1">
                    <li class="flex items-center gap-2">
                      <span class="text-cyan-400">▸</span>
                      <span><strong>Violencia de Fantasía Leve</strong> (<em>Fantasy Violence</em>)</span>
                    </li>
                    <li class="flex items-center gap-2">
                      <span class="text-cyan-400">▸</span>
                      <span><strong>Destellos Luminosos Controlados</strong> (<em>Mild Arcade Flash Effects</em>)</span>
                    </li>
                    <li class="flex items-center gap-2">
                      <span class="text-cyan-400">▸</span>
                      <span><strong>Cero Sangre / Cero Gore / Cero Lenguaje Inapropiado</strong></span>
                    </li>
                  </ul>
                </div>
              </div>

              <div class="space-y-3 text-sm text-slate-300 leading-relaxed">
                <h4 class="font-bold text-cyan-300 uppercase text-xs tracking-wider">
                  Análisis Técnico de Intensidad Visual (Extraído de game.js)
                </h4>
                <p>
                  Los luchadores (<strong>KAI</strong> y <strong>VEX</strong>) son siluetas biónicas abstractas construidas con primitivas geométricas (<code class="text-cyan-300">fillRoundedRect</code>, <code class="text-cyan-300">fillTriangle</code>, <code class="text-cyan-300">fillCircle</code>). Los impactos se representan mediante destellos blancos de <code class="text-cyan-300">150 ms</code>, partículas de neón aditivas y sacudidas de cámara acotadas (<code class="text-cyan-300">70 ms</code> a <code class="text-cyan-300">360 ms</code>), sin daño anatómico realista.
                </p>
                <div class="p-4 rounded-xl bg-cyan-500/10 border-l-4 border-l-cyan-400 text-xs text-slate-200">
                  <strong>Justificación Creativa:</strong> La acción transcurre en un torneo deportivo cyber-marcial regulado donde dos exoesqueletos compiten mediante pulsos fotónicos, ofreciendo toda la emoción competitiva de un arcade clásico en un entorno seguro y apto para mayores de 10 años.
                </div>
              </div>
            </article>

            <!-- Privacidad y Manejo de Datos Locales -->
            <article class="lg:col-span-6 rounded-3xl bg-[#110b22]/95 border border-emerald-500/30 p-7 sm:p-8 shadow-2xl space-y-6">
              <div class="flex items-center gap-4 pb-5 border-b border-slate-800">
                <div class="w-14 h-14 rounded-2xl bg-emerald-500/15 border border-emerald-400/40 flex items-center justify-center text-3xl">
                  🔒
                </div>
                <div>
                  <span class="text-xs font-extrabold tracking-[0.2em] text-emerald-400 uppercase block">
                    ARQUITECTURA ZERO-TELEMETRY
                  </span>
                  <h3 class="text-2xl font-bold text-white">Privacidad y Ejecución 100% en Cliente</h3>
                </div>
              </div>

              <p class="text-sm text-slate-300 leading-relaxed">
                <strong>NEON KOMBAT: Cyber Arena</strong> se ejecuta <strong>100% del lado del cliente (Client-Side)</strong> dentro del entorno aislado (<em>sandbox</em>) del navegador web del jugador:
              </p>

              <ul class="space-y-3 text-xs sm:text-sm text-slate-300">
                <li class="p-3.5 rounded-xl bg-[#090514]/85 border-l-4 border-l-emerald-400">
                  <strong class="text-white block mb-0.5">1. Estado Efímero en Memoria RAM:</strong>
                  La dificultad elegida (<code class="text-emerald-300">facil</code>, <code class="text-emerald-300">normal</code>, <code class="text-emerald-300">dificil</code>), el estado de silencio y las estadísticas de combate viven únicamente en variables volátiles de JavaScript entre escenas (<code class="text-emerald-300">MenuScene → FightScene → ResultScene</code>) y se destruyen al cerrar la pestaña.
                </li>
                <li class="p-3.5 rounded-xl bg-[#090514]/85 border-l-4 border-l-emerald-400">
                  <strong class="text-white block mb-0.5">2. Cero Cookies ni Rastreo Persistente:</strong>
                  El juego no utiliza cookies de seguimiento ni almacena perfiles personales en <code class="text-emerald-300">localStorage</code> o <code class="text-emerald-300">IndexedDB</code>.
                </li>
                <li class="p-3.5 rounded-xl bg-[#090514]/85 border-l-4 border-l-emerald-400">
                  <strong class="text-white block mb-0.5">3. Cero Exfiltración de Datos Personales:</strong>
                  No realiza peticiones a servidores externos ni recolecta telemetría de usuario, garantizando privacidad absoluta por diseño (<em>Privacy by Design</em>).
                </li>
              </ul>
            </article>
          </div>

          <!-- Tabla de Auditoría de Propiedad Intelectual y Atribuciones -->
          <div class="rounded-3xl bg-[#110b22]/95 border border-amber-500/30 p-7 sm:p-9 shadow-2xl">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
              <div>
                <span class="text-xs font-extrabold tracking-[0.2em] text-amber-400 uppercase block mb-1">
                  PROPIEDAD INTELECTUAL · AUDITORÍA Y ATRIBUCIÓN
                </span>
                <h3 class="text-2xl font-bold text-white">
                  Licencia del Código (MIT License) y Créditos Tecnológicos
                </h3>
              </div>
              <span class="px-4 py-1.5 rounded-full bg-amber-500/15 border border-amber-400/50 text-amber-300 text-xs font-extrabold">
                © 2026 Jahir Rocha · MIT License
              </span>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse text-sm">
                <thead>
                  <tr class="border-b border-slate-800 text-xs uppercase tracking-wider text-cyan-400 bg-[#090514]/90">
                    <th class="py-3.5 px-4 rounded-tl-xl">Recurso / Componente</th>
                    <th class="py-3.5 px-4">Tipo</th>
                    <th class="py-3.5 px-4">Autor / Proveedor</th>
                    <th class="py-3.5 px-4">Licencia</th>
                    <th class="py-3.5 px-4 rounded-tr-xl">Uso en el Proyecto</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/70 text-slate-300">
                  {atribuciones.map((row) => (
                    <tr class="hover:bg-white/[0.02] transition">
                      <td class="py-3.5 px-4 font-bold text-white">{row.recurso}</td>
                      <td class="py-3.5 px-4 text-xs">{row.tipo}</td>
                      <td class="py-3.5 px-4 text-xs">{row.autor}</td>
                      <td class="py-3.5 px-4">
                        <span class="inline-block px-2.5 py-0.5 rounded bg-cyan-500/15 text-cyan-300 border border-cyan-500/30 text-xs font-bold whitespace-nowrap">
                          {row.licencia}
                        </span>
                      </td>
                      <td class="py-3.5 px-4 text-xs text-slate-400">{row.uso}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- =====================================================================
           6. CTA FINAL DE CONVERSIÓN
           ===================================================================== -->
      <section class="py-16">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <div
            class="rounded-3xl bg-gradient-to-r from-[#190d30] via-[#2b1040] to-[#190d30] border-2 border-cyan-400/70 p-8 sm:p-12 text-center box-glow-cyan space-y-6"
          >
            <span class="inline-block px-4 py-1 rounded-full bg-cyan-500/15 border border-cyan-400/40 text-cyan-300 text-xs font-extrabold tracking-[0.2em] uppercase">
              ⚡ LA ARENA DE NEO-KYOTO TE ESPERA ⚡
            </span>
            <h2 class="font-display text-4xl sm:text-5xl tracking-wider uppercase text-white">
              ¿Listo para derrotar a VEX en el Cyber-Dojo?
            </h2>
            <p class="max-w-2xl mx-auto text-slate-200 text-base sm:text-lg">
              Entra directamente al canvas interactivo de <strong>NEON KOMBAT: Cyber Arena</strong>. Sin instalaciones, con gráficos vectoriales y audio sintetizado en vivo a 60 FPS.
            </p>
            <div class="pt-2">
              <a
                href={gameUrl}
                class="inline-flex flex-col items-center justify-center px-9 py-4 rounded-2xl bg-gradient-to-r from-rose-600 via-rose-500 to-orange-500 text-white font-extrabold border-2 border-white shadow-[0_0_40px_rgba(255,42,84,0.8)] hover:shadow-[0_0_55px_rgba(0,240,255,0.85)] hover:border-cyan-300 hover:-translate-y-0.5 transition-all"
              >
                <span class="text-xl tracking-wider uppercase">⚡ ¡JUGAR AHORA EN EL NAVEGADOR!</span>
                <span class="text-xs text-rose-100 mt-0.5">Ruta directa: {gameUrl}</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800/80 bg-[#06030d] py-8 text-xs text-slate-400">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <strong class="text-white text-sm">⚡ NEON KOMBAT: Cyber Arena (ISWD823)</strong>
          <p class="mt-0.5">Desarrollado por Jahir Rocha · Escuela Politécnica Nacional · Distribuido bajo MIT License.</p>
        </div>
        <div class="flex items-center gap-6 font-bold text-cyan-400">
          <a href={gameUrl} class="hover:text-white transition">Jugar Ahora</a>
          <a
            href="https://github.com/2026B-Sof-Jueg-Gr3/rocha-jahir-jueg-gr3"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-white transition"
          >
            Repositorio GitHub ↗
          </a>
        </div>
      </div>
    </footer>

    <!-- Script para activar la cabina interactiva embebida bajo demanda -->
    <script is:inline>
      const btnInline = document.getElementById('btn-launch-inline');
      const btnOverlayInline = document.getElementById('btn-overlay-inline');
      const btnClosePreview = document.getElementById('btn-toggle-preview');
      const previewWrapper = document.getElementById('arena-preview-wrapper');
      const iframeWrapper = document.getElementById('arena-iframe-wrapper');
      const arenaIframe = document.getElementById('arena-iframe');

      function activateInlineGame() {
        if (!previewWrapper || !iframeWrapper || !arenaIframe) return;
        const targetSrc = arenaIframe.getAttribute('data-src');
        if (targetSrc && !arenaIframe.getAttribute('src')) {
          arenaIframe.setAttribute('src', targetSrc);
        }
        previewWrapper.classList.add('hidden');
        iframeWrapper.classList.remove('hidden');
        if (btnClosePreview) btnClosePreview.classList.remove('hidden');
        arenaIframe.focus();
      }

      function closeInlineGame() {
        if (!previewWrapper || !iframeWrapper || !arenaIframe) return;
        arenaIframe.removeAttribute('src');
        iframeWrapper.classList.add('hidden');
        previewWrapper.classList.remove('hidden');
        if (btnClosePreview) btnClosePreview.classList.add('hidden');
      }

      if (btnInline) btnInline.addEventListener('click', activateInlineGame);
      if (btnOverlayInline) btnOverlayInline.addEventListener('click', activateInlineGame);
      if (btnClosePreview) btnClosePreview.addEventListener('click', closeInlineGame);
    </script>
  </body>
</html>
