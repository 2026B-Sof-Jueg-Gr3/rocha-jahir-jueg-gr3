---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NEON KOMBAT: Cyber Arena — Escaparate Oficial | ISWD823</title>
    <meta
      name="description"
      content="En la cima del último Cyber-Dojo de Neo-Kyoto, encarna a KAI y derrota a la IA VEX en duelos 1 vs 1 de 60 segundos. Fighting game arcade 100% procedimental en Phaser 4.0."
    />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>

  <body class="min-h-screen bg-[#090514] text-slate-100 selection:bg-cyan-400 selection:text-slate-950">
    <!-- Capa de Fondo Ambiental Synthwave / Cyber-Dojo -->
    <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,#26103d_0%,#090514_70%)]"></div>
      <div
        class="absolute top-[6%] left-1/2 -translate-x-1/2 w-[520px] h-[520px] rounded-full bg-gradient-to-b from-amber-400/20 via-rose-500/15 to-transparent blur-2xl"
      ></div>
      <div class="absolute -left-32 top-1/4 w-96 h-96 rounded-full bg-cyan-500/15 blur-[130px]"></div>
      <div class="absolute -right-32 top-1/3 w-96 h-96 rounded-full bg-rose-500/15 blur-[130px]"></div>
      <div class=" absolute bottom-0 -left-1/4 -right-1/4 h-[42vh] cyber-grid-floor opacity-75"></div>
    </div>

    <!-- =====================================================================
         NAVBAR ESTILO HUD ARCADE
         ===================================================================== -->
    <header
      class="sticky top-0 z-50 border-b border-cyan-500/25 bg-[#090514]/85 backdrop-blur-xl shadow-[0_10px_30px_rgba(0,0,0,0.65)]"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
        <a href="#top" class="flex items-center gap-3 group">
          <div
            class="w-11 h-11 rounded-xl bg-gradient-to-br from-cyan-500/20 to-rose-500/20 border border-cyan-400/50 flex items-center justify-center text-2xl shadow-[0_0_15px_rgba(0,240,255,0.3)] group-hover:scale-105 transition"
          >
            ⚡
          </div>
          <div>
            <span class="font-display text-2xl tracking-wider text-white block leading-none text-glow-cyan">
              NEON KOMBAT
            </span>
            <span class="text-[11px] font-bold tracking-[0.22em] text-cyan-400 uppercase block mt-0.5">
              CYBER ARENA · PHASER 4.0
            </span>
          </div>
        </a>

        <nav class="hidden md:flex items-center gap-7 text-sm font-semibold text-slate-300">
          <a href="#identidad" class="hover:text-cyan-400 transition">Identidad</a>
          <a href="#lore" class="hover:text-cyan-400 transition">Lore y Dossiers</a>
          <a href="#resonancia" class="hover:text-cyan-400 transition">Resonancia y Frame Data</a>
          <a href="#controles" class="hover:text-cyan-400 transition">Controles</a>
          <a href="#cumplimiento" class="hover:text-cyan-400 transition">ESRB y Legal</a>
        </nav>

        <div class="flex items-center gap-3">
          <a
            href={gameUrl}
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-extrabold text-sm tracking-wider uppercase text-white bg-gradient-to-r from-rose-600 via-rose-500 to-orange-500 border border-white/80 shadow-[0_0_24px_rgba(255,42,84,0.6)] hover:shadow-[0_0_35px_rgba(0,240,255,0.7)] hover:border-cyan-300 hover:-translate-y-0.5 transition-all"
          >
            <span>⚡ JUGAR AHORA</span>
          </a>
        </div>
      </div>
    </header>

    <main id="top">
      <!-- =====================================================================
           1. HERO SECTION + ESCAPARATE INTERACTIVO DEL CANVAS
           ===================================================================== -->
      <section class="relative pt-10 pb-20 lg:pt-16 lg:pb-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
            <!-- Columna Izquierda: Pitch Comercial, Logline y Conversión -->
            <div class="lg:col-span-6 space-y-6">
              <div
                class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-400/40 text-cyan-300 text-xs font-extrabold tracking-[0.16em] uppercase"
              >
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
                <span>TORNEO CYBER-DOJO 1 VS 1 · CERO ASSETS EXTERNOS</span>
              </div>

              <div class="space-y-2">
                <h1
                  class="font-display text-5xl sm:text-6xl lg:text-7xl tracking-wider uppercase leading-[0.95] text-white"
                >
                  NEON <span class="text-cyan-400 text-glow-cyan">KOMBAT</span>
                </h1>
                <p class="font-display text-2xl sm:text-3xl tracking-[0.28em] text-amber-400 text-glow-gold uppercase">
                  CYBER ARENA · ISWD823
                </p>
              </div>

              <!-- Logline (Premisa Comercial de Impacto) -->
              <div
                class="relative rounded-2xl bg-[#120b24]/90 border border-cyan-500/30 border-l-4 border-l-cyan-400 p-5 shadow-xl"
              >
                <span class="text-[11px] font-extrabold uppercase tracking-[0.2em] text-cyan-400 block mb-1.5">
                  🎯 LOGLINE OFICIAL
                </span>
                <p class="text-slate-200 text-base sm:text-lg leading-relaxed">
                  En la cima del último Cyber-Dojo de Neo-Kyoto, encarna a <strong class="text-cyan-300">KAI</strong>,
                  un artista marcial biónico que debe derrotar al mejor de tres asaltos de 60 segundos a
                  <strong class="text-rose-400">VEX</strong>, el implacable ejecutor algorítmico de la red central.
                  Domina cada <em class="text-amber-300">frame</em> de impacto, bloquea con precisión milimétrica y
                  sobrecarga tu núcleo de plasma para desatar la <em class="text-cyan-300">Onda Neón</em> antes de que
                  tu código vital sea purgado.
                </p>
              </div>

              <!-- Tagline + Botones de Conversión -->
              <div class="space-y-4 pt-1">
                <p class="text-amber-300 font-bold text-sm sm:text-base tracking-wide flex items-center gap-2">
                  <span>⚡</span>
                  <span>«Domina el Pulso. Quiebra el Algoritmo. ¡ENTRA AL CYBER-DOJO AHORA!»</span>
                </p>

                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
                  <a
                    href={gameUrl}
                    class="group relative inline-flex flex-col items-center justify-center px-7 py-4 rounded-2xl bg-gradient-to-r from-rose-600 via-rose-500 to-orange-500 text-white font-extrabold border-2 border-white shadow-[0_0_35px_rgba(255,42,84,0.65)] hover:shadow-[0_0_45px_rgba(0,240,255,0.75)] hover:border-cyan-300 hover:-translate-y-0.5 transition-all text-center"
                  >
                    <span class="text-lg tracking-wider flex items-center gap-2">
                      <span>⚡ ¡JUGAR AHORA!</span>
                      <span class="text-xs px-2 py-0.5 rounded bg-black/30 border border-white/30">PANTALLA COMPLETA</span>
                    </span>
                    <span class="text-xs font-medium text-rose-100 mt-0.5">
                      Abrir el canvas oficial en /my-first-game/ · 60 FPS
                    </span>
                  </a>

                  <button
                    type="button"
                    id="btn-launch-inline"
                    class="inline-flex flex-col items-center justify-center px-6 py-4 rounded-2xl bg-cyan-500/10 hover:bg-cyan-500/20 border-2 border-cyan-400/60 hover:border-cyan-300 text-cyan-300 font-bold transition-all cursor-pointer text-center"
                  >
                    <span class="text-base tracking-wide">🕹️ PROBAR EN VIVO AQUÍ</span>
                    <span class="text-xs text-slate-400 font-normal mt-0.5">Cargar cabina interactiva en página</span>
                  </button>
                </div>
              </div>

              <!-- Métricas Clave del Motor -->
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
                <div class="rounded-xl bg-[#110c1f]/90 border border-slate-800 p-3.5">
                  <span class="font-display text-2xl text-cyan-400 block">100%</span>
                  <span class="text-xs text-slate-400">Arte y Audio Procedimental</span>
                </div>
                <div class="rounded-xl bg-[#110c1f]/90 border border-slate-800 p-3.5">
                  <span class="font-display text-2xl text-amber-400 block">60 SEG</span>
                  <span class="text-xs text-slate-400">Al Mejor de 3 Rounds</span>
                </div>
                <div class="rounded-xl bg-[#110c1f]/90 border border-slate-800 p-3.5">
                  <span class="font-display text-2xl text-rose-400 block">3 NIVELES</span>
                  <span class="text-xs text-slate-400">IA Táctica (VEX CPU)</span>
                </div>
                <div class="rounded-xl bg-[#110c1f]/90 border border-slate-800 p-3.5">
                  <span class="font-display text-2xl text-emerald-400 block">PHASER 4.0</span>
                  <span class="text-xs text-slate-400">WebGL + Web Audio API</span>
                </div>
              </div>
            </div>

            <!-- Columna Derecha: Cabina Cyber-Dojo (Vista Previa SVG + Iframe Jugable Bajo Demanda) -->
            <div class="lg:col-span-6">
              <div
                class="rounded-2xl bg-[#0d0818] border-2 border-cyan-400/50 box-glow-cyan overflow-hidden transition-all"
              >
                <!-- Barra Superior de la Cabina Arcade -->
                <div
                  class="px-4 py-3 bg-[#140d26] border-b border-slate-800 flex items-center justify-between gap-2"
                >
                  <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-rose-500"></span>
                    <span class="w-3 h-3 rounded-full bg-amber-400"></span>
                    <span class="w-3 h-3 rounded-full bg-cyan-400"></span>
                    <span class="ml-2 text-xs font-bold tracking-wider text-slate-300 uppercase">
                      CABINA ARCADE · 960×540 PX
                    </span>
                  </div>
                  <div class="flex items-center gap-2">
                    <button
                      type="button"
                      id="btn-toggle-preview"
                      class="hidden text-xs font-bold px-2.5 py-1 rounded bg-slate-800 text-slate-300 hover:text-white cursor-pointer"
                    >
                      ✕ Cerrar Vista en Vivo
                    </button>
                    <a
                      href={gameUrl}
                      class="text-xs font-bold px-2.5 py-1 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-400/40 hover:bg-cyan-500/30 transition"
                    >
                      ⤢ Pantalla Completa
                    </a>
                  </div>
                </div>

                <!-- Contenedor del Escenario (SVG por defecto / Iframe interactivo al pulsar Probar) -->
                <div class="relative aspect-video w-full bg-[#090514]">
                  <!-- Vista Previa Vectorial Fiel de FightScene -->
                  <div id="arena-preview-wrapper" class="w-full h-full relative group">
                    <svg
                      class="w-full h-full block"
                      viewBox="0 0 960 540"
                      role="img"
                      aria-label="Recreación visual del combate entre KAI y VEX en NEON KOMBAT: Cyber Arena"
                    >
                      <defs>
                        <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="0%" stop-color="#070410" />
                          <stop offset="100%" stop-color="#2c113c" />
                        </linearGradient>
                        <linearGradient id="floorGrad" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="0%" stop-color="#160c28" />
                          <stop offset="100%" stop-color="#07040d" />
                        </linearGradient>
                        <filter id="neonCyan" x="-30%" y="-30%" width="160%" height="160%">
                          <feDropShadow dx="0" dy="0" stdDeviation="6" flood-color="#00f0ff" flood-opacity="0.85" />
                        </filter>
                        <filter id="neonCrimson" x="-30%" y="-30%" width="160%" height="160%">
                          <feDropShadow dx="0" dy="0" stdDeviation="6" flood-color="#ff2a54" flood-opacity="0.85" />
                        </filter>
                      </defs>

                      <rect width="960" height="456" fill="url(#skyGrad)" />
                      <circle cx="480" cy="215" r="155" fill="#ff2a54" fill-opacity="0.16" />
                      <circle cx="480" cy="215" r="115" fill="#ff6d00" fill-opacity="0.28" />
                      <circle cx="480" cy="215" r="82" fill="#ffd600" fill-opacity="0.42" />

                      <polygon points="0,456 180,250 390,456" fill="#120824" />
                      <polygon points="260,456 480,235 700,456" fill="#120824" />
                      <polygon points="570,456 790,245 960,456" fill="#120824" />

                      <rect x="25" y="255" width="75" height="201" fill="#0b0616" />
                      <rect x="110" y="285" width="65" height="171" fill="#0b0616" />
                      <rect x="185" y="240" width="82" height="216" fill="#0b0616" />
                      <rect x="695" y="248" width="80" height="208" fill="#0b0616" />
                      <rect x="785" y="280" width="68" height="176" fill="#0b0616" />
                      <rect x="862" y="235" width="75" height="221" fill="#0b0616" />

                      <rect x="0" y="456" width="960" height="84" fill="url(#floorGrad)" />
                      <line x1="0" y1="456" x2="960" y2="456" stroke="#00f0ff" stroke-width="3.5" stroke-opacity="0.8" />
                      <line x1="0" y1="478" x2="960" y2="478" stroke="#ff2a54" stroke-width="1" stroke-opacity="0.3" />
                      <line x1="0" y1="506" x2="960" y2="506" stroke="#ff2a54" stroke-width="1" stroke-opacity="0.3" />
                      <line x1="190" y1="456" x2="-245" y2="540" stroke="#00f0ff" stroke-width="1.5" stroke-opacity="0.25" />
                      <line x1="306" y1="456" x2="45" y2="540" stroke="#00f0ff" stroke-width="1.5" stroke-opacity="0.25" />
