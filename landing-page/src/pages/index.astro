  { tecla: 'Tecla J', accion: 'Puñetazo Rápido (Jab)', detalle: '6 PTS de daño · +20% de energía al impactar', cat: 'ATAQUE' },
  { tecla: 'Tecla K', accion: 'Patada de Largo Alcance', detalle: '10 PTS de daño · Alto retroceso (knockback 295)', cat: 'ATAQUE' },
