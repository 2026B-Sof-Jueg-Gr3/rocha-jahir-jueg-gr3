---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const landingUrl = `${base}/`;
const gameScriptUrl = `${base}/my-first-game/game.js?v=4.0`;
const isEmbed = Astro.url.searchParams.get('embed') === '1';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>NEON KOMBAT: Cyber Arena - ISWD823</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <style>
      * {
        box-sizing: border-box;
        user-select: none;
        -webkit-user-select: none;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
        background: radial-gradient(circle at center, #1a1025 0%, #09060f 100%);
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      }
      canvas {
        display: block;
        box-shadow: 0 0 40px rgba(0, 240, 255, 0.25), 0 0 80px rgba(255, 42, 84, 0.15);
        border: 2px solid #2a2438;
        border-radius: 6px;
      }
      .back-hud-btn {
        position: fixed;
        top: 14px;
        left: 16px;
        z-index: 9999;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 8px;
        background: rgba(15, 10, 28, 0.88);
        border: 1.5px solid rgba(0, 240, 255, 0.55);
        color: #00f0ff;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.6px;
        text-decoration: none;
        backdrop-filter: blur(8px);
        box-shadow: 0 0 18px rgba(0, 240, 255, 0.22);
        transition: all 0.18s ease;
      }
      .back-hud-btn:hover {
        background: rgba(0, 240, 255, 0.16);
        border-color: #00f0ff;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 0 24px rgba(0, 240, 255, 0.45);
      }
    </style>
    <!-- Phaser 4.0.0 CDN -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/phaser@4.0.0/dist/phaser.min.js"></script>
  </head>
  <body>
    {!isEmbed && (
      <a href={landingUrl} id="back-to-landing" class="back-hud-btn" title="Volver al Escaparate Digital">
        <span>⬅</span>
        <span>VOLVER A LA LANDING PAGE</span>
      </a>
    )}
    <script is:inline src={gameScriptUrl}></script>
    <script is:inline>
      // Si se carga dentro de un iframe en la Landing Page, ocultar el botón superior
      if (window.self !== window.top) {
        const backBtn = document.getElementById('back-to-landing');
        if (backBtn) backBtn.style.display = 'none';
      }
    </script>
  </body>
</html>

